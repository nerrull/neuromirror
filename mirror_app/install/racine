#!/bin/bash
# racine -- start, stop and watch the installation.
#
# Runs either from the kiosk account itself or over SSH from the admin
# account: as the kiosk user it talks to its own GUI domain, as anyone else
# (root included) it targets the kiosk user's domain by uid.
#
#   racine start | stop | restart | status | log | build
#   racine days                 -- is today a show day, and what is scheduled
#   racine keep-awake on | off  -- override the show-day gate while working
#   racine display [save|install] -- the arrangement launch.sh applies;
#                                  install = apply it at *this* account's login too
#
set -euo pipefail

LABEL=net.jardinsracine.mirror
KIOSK_USER="${RACINE_KIOSK_USER:-expo}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"          # the jardins_racine checkout
LOG="/Users/Shared/racine/logs/mirror.log"

# Before anything that looks the account up: without this the dscl below dies
# under `set -e` with a bare exit 56 and no word about why.
kiosk_uid="$(id -u "$KIOSK_USER" 2>/dev/null || true)"
[ -n "$kiosk_uid" ] || {
    echo "no such user: $KIOSK_USER (set RACINE_KIOSK_USER, or create it)" >&2
    exit 1
}
DOMAIN="gui/$kiosk_uid"

kiosk_home="$(dscl . -read "/Users/$KIOSK_USER" NFSHomeDirectory 2>/dev/null \
              | awk '{print $2}')" || kiosk_home=""
PLIST="${kiosk_home:-/Users/$KIOSK_USER}/Library/LaunchAgents/$LABEL.plist"

# Reaching into another user's GUI domain needs root; our own does not.
# A function, not an array: macOS's bash 3.2 treats an empty array as unset
# under `set -u`, so `"${AS[@]}"` killed every command run as the kiosk user
# (the Desktop shortcuts) with "AS[@]: unbound variable".
if [ "$(id -u)" = "$kiosk_uid" ]; then as() { "$@"; }; else as() { sudo "$@"; }; fi

usage() { sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1; }

case "${1:-}" in
start)
    as launchctl bootstrap "$DOMAIN" "$PLIST"
    echo "started"
    ;;
stop)
    # bootout unloads the agent, so KeepAlive does not fight the stop.
    as launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    echo "stopped"
    ;;
restart)
    as launchctl kickstart -k "$DOMAIN/$LABEL"
    echo "restarted"
    ;;
status)
    as launchctl print "$DOMAIN/$LABEL" 2>/dev/null \
        | grep -E '^\s+(state|pid|last exit code|runs) ' \
        || echo "not loaded"
    ;;
log)
    tail -f "$LOG"
    ;;
days)
    # --check reports without ever sleeping, so this is safe to run mid-show.
    "$HERE/show-gate.sh" --check
    echo
    echo "listed days ($HERE/show-days.txt):"
    grep -v '^\s*\(#\|$\)' "$HERE/show-days.txt" 2>/dev/null | sed 's/^/  /' \
        || echo "  (none -- the gate will fail awake)"
    echo
    pmset -g sched
    ;;
display)
    # Rotation is a per-user preference macOS forgets across user switches.
    # `save` captures this session's arrangement as a displayplacer command;
    # launch.sh runs it before the piece starts. Save from the session that
    # looks right, with the show's monitors and only those plugged in.
    ARR=/Users/Shared/racine/display.sh
    DP=/opt/homebrew/bin/displayplacer
    case "${2:-}" in
        save)
            [ -x "$DP" ] || { echo "no displayplacer -- brew install displayplacer" >&2; exit 1; }
            cmd="$("$DP" list | grep '^displayplacer ')"
            [ -n "$cmd" ] || { echo "displayplacer printed no arrangement" >&2; exit 1; }
            as tee "$ARR" >/dev/null <<<"$cmd"
            as chmod 644 "$ARR"
            echo "saved to $ARR:"; echo "  $cmd";;
        install)
            # A LaunchAgent for the account running this, in its own domain
            # -- launch.sh already covers the kiosk account.
            dst="$HOME/Library/LaunchAgents/net.jardinsracine.display.plist"
            mkdir -p "$(dirname "$dst")"
            sed "s|@ROTATE_SH@|$HERE/rotate.sh|g" "$HERE/net.jardinsracine.display.plist.in" > "$dst"
            launchctl bootout "gui/$(id -u)/net.jardinsracine.display" 2>/dev/null || true
            launchctl bootstrap "gui/$(id -u)" "$dst"
            echo "installed $dst -- rotation applied at each login of $(id -un)";;
        *)
            [ -r "$ARR" ] && { echo "$ARR:"; sed 's/^/  /' "$ARR"; } \
                || echo "none saved -- racine display save";;
    esac
    ;;
keep-awake)
    # The gate sleeps the machine on any morning that is not a show day,
    # which includes the morning you are stood in front of it working. This
    # marker turns it off without editing the calendar -- and is deliberately
    # a file you can see, so it is hard to leave set by accident.
    MARKER=/Users/Shared/racine/keep-awake
    case "${2:-}" in
        on)  as touch "$MARKER"; echo "gate overridden -- remember to turn it off";;
        off) as rm -f "$MARKER"; echo "gate back in charge";;
        *)   [ -e "$MARKER" ] && echo "on (gate overridden)" || echo "off (gate in charge)";;
    esac
    ;;
build)
    # Rebuild and re-sign in one step. The signature is what TCC keys the
    # camera and microphone grants to: an unsigned or re-ad-hoc-signed binary
    # asks again on next launch, behind a fullscreen window, with nobody
    # there to click Allow. See install/README.md.
    cmake --build "$ROOT/build" --target mirror_app -j"$(sysctl -n hw.logicalcpu)"
    # Default: the Apple Development identity in the artist's login keychain
    # (team B6C64D8M6K, valid to 2027-04). `security find-identity -v -p
    # codesigning` lists what's available; override with RACINE_SIGNING_ID.
    codesign -s "${RACINE_SIGNING_ID:-DE5193F0519AD4207DA3778BABC7E3EE0EFA7892}" --force \
        "$ROOT/build/mirror_app/mirror_app"
    echo "built and signed"
    ;;
*)
    usage
    ;;
esac
