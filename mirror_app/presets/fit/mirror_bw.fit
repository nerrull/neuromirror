# mirror_app settings -- bank: fit
# migrated out of presets/mirror/mirror_bw.mirror, where these used
# to ride along with the ripple settings and overwrite
# whatever the fit had been set to. Section renamed from "mirror" to
# "fit" when the fit and debug tabs were split out of the machine/
# mirror pages -- same bank, same values, new key prefix.
p fit/animate z outside = 0
p fit/crop/grid = 1
p fit/crop/lr = 0.002
p fit/crop/steps = 4
p fit/fade starts = 0.02
p fit/fade width = 0.35
p fit/feed/grid = 3
p fit/feed/lr = 0.003
p fit/feed/steps = 1
p fit/follow the outline = 1
p fit/grey outside = 0
p fit/soft edge = 1
p fit/track live feed = 0
